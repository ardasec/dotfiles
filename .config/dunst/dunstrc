[global]
    # Display
    monitor = 0
    follow = none
    
    # Geometry
    width = (0, 350)
    height = (0, 300)
    origin = top-right
    offset = (10, 40)
    
    # Progress bar
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    
    # Appearance
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    gap_size = 5
    separator_height = 2
    separator_color = frame
    corner_radius = 8
    
    # Text
    font = JetBrains Mono 12
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    
    # Icons
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/devices/:/usr/share/icons/Papirus-Dark/16x16/apps/
    
    # History
    sticky_history = yes
    history_length = 20
    
    # Behavior
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all
    
    # Timeouts (in seconds)
    idle_threshold = 120

# Everforest Dark Medium colors
[urgency_low]
    background = "#232a2e"
    foreground = "#d3c6aa"
    frame_color = "#7a8478"
    timeout = 5
    
[urgency_normal]
    background = "#232a2e"
    foreground = "#d3c6aa"
    frame_color = "#a7c080"
    timeout = 10
    
[urgency_critical]
    background = "#232a2e"
    foreground = "#d3c6aa"
    frame_color = "#e67e80"
    timeout = 0
